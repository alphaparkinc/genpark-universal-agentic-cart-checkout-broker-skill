{
  "name": "genpark-universal-agentic-cart-checkout-broker-skill",
  "version": "1.0.0",
  "description": "GenPark AI Agent Skill - Universal agentic cart checkout broker aggregating multi-merchant catalogs, consolidated shipping, and UCP checkout sessions.",
  "author": "genpark",
  "category": "agent-commerce",
  "tags": [
    "agentic-commerce",
    "universal-commerce-protocol",
    "multi-merchant-cart",
    "autonomous-checkout",
    "ucp-gateway"
  ],
